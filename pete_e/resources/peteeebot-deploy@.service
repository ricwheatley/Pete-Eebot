[Unit]
Description=Pete-Eebot deployment worker for job %i
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory=/opt/myapp/current
EnvironmentFile=/opt/myapp/shared/.env
ExecStart=/opt/myapp/shared/venv/bin/python3 -m pete_e.deployment_worker %i
Restart=no
KillMode=control-group
TimeoutStartSec=infinity

# This unit intentionally has no PartOf=, BindsTo=, or WantedBy= relationship
# with peteeebot.service. It must survive that API service being restarted.
